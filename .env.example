# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
# .env wird NICHT ins Git committed (siehe .gitignore)!

# Die Host-Ports stehen fest in docker-compose.yml. Wer sie dort aendert, traegt
# denselben Wert hier ein: die Loader, pruefe_szenarien.py und dbt lesen ihn von hier.
# In Airbyte selbst muss der Port zusaetzlich in scripts/airbyte/setup_objects.py
# angepasst werden, dort steht er im Source-/Destination-Payload.

# ─── Source PostgreSQL ────────────────────────────────────────────────────────
SOURCE_PG_DB=sourcedb
SOURCE_PG_USER=sourceuser
SOURCE_PG_PASSWORD=sourcepassword
SOURCE_PG_PORT=5433

# ─── Destination PostgreSQL ───────────────────────────────────────────────────
DEST_PG_DB=destdb
DEST_PG_USER=destuser
DEST_PG_PASSWORD=destpassword
DEST_PG_PORT=5434

# ─── Destination MySQL ────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
DEST_MYSQL_DB=destdb
DEST_MYSQL_USER=destuser
DEST_MYSQL_PASSWORD=destpassword

# ─── Airbyte Public API (fuer scripts/airbyte/setup_objects.py) ───────────────
# Client-ID und Secret stehen in der UI unter User -> Applications, oder im
# Klartext in der Ausgabe von `abctl local credentials`.
# Leer lassen ist okay: das Skript liest sie dann selbst per abctl aus.
AIRBYTE_API_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
